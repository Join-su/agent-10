# 실제 값은 .env 에만 넣고 Git 에 커밋하지 않습니다.  cp .env.example .env
# fixture: 키 없이 돈다. live: 임베딩·Tool 선택·초안 문장을 실제 OpenAI 가 맡는다(비용 발생).
APP_MODE=fixture
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# live 임베딩 차원. fixture 는 녹화된 256차원을 쓴다.
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- 저장소 (선택) ---------------------------------------------------------------
# 기본은 메모리 FAISS(매뉴얼 vector)와 SQLite(정비 이력)라 DB 없이 돈다.
# Postgres 를 쓰려면: docker compose up -d db → 적재 스크립트 두 개 → 아래 둘을 바꾼다.
VECTOR_BACKEND=faiss
HISTORY_BACKEND=sqlite
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# 호스트에서 직접 실행할 때. compose 의 db 가 5434 로 내보낸다(컨테이너끼리는 compose 가 주소를 만든다).
DATABASE_URL=postgresql+psycopg://task10:replace-with-a-strong-local-password@127.0.0.1:5434/task10

# 검토 대기 건을 파일에 남긴다. 비우면 프로세스가 사는 동안만 유지된다.
THREAD_DB=
# 정비 이력 Tool 을 별도 Process 의 MCP 서버에서 가져온다.
MCP_MODE=off
