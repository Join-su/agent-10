# 실제 값은 .env 에만 넣고 Git 에 커밋하지 않습니다.  cp .env.example .env
# fixture: 키 없이 돈다. live: 임베딩·Tool 선택·초안 문장을 실제 OpenAI 가 맡는다(비용 발생).
APP_MODE=fixture
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# live 임베딩 차원. fixture 는 녹화된 256차원을 쓴다. 바꾸면 매뉴얼을 다시 적재한다.
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- DB: Postgres(pgvector) 하나 ------------------------------------------------
# 매뉴얼 vector · 정비 이력 · 검토 대기 건이 모두 여기 있다.
# docker compose up -d db 가 127.0.0.1:5434 로 띄운다. 비밀번호는 아래 두 곳이 같아야 한다.
POSTGRES_PASSWORD=replace-with-a-strong-local-password
DATABASE_URL=postgresql+psycopg://task10:replace-with-a-strong-local-password@127.0.0.1:5434/task10

# 정비 이력 Tool 을 별도 Process 의 MCP 서버에서 가져온다.
MCP_MODE=off
