{
 "$defs": {
  "CauseCandidate": {
   "additionalProperties": false,
   "description": "원인 후보. **LLM 이 쓰되 근거 ID 가 없으면 받지 않는다.**",
   "properties": {
    "rank": {
     "minimum": 1,
     "title": "Rank",
     "type": "integer"
    },
    "failure_type": {
     "enum": [
      "TWF",
      "HDF",
      "PWF",
      "OSF",
      "RNF",
      "UNKNOWN"
     ],
     "title": "Failure Type",
     "type": "string"
    },
    "rationale": {
     "title": "Rationale",
     "type": "string"
    },
    "evidence_ids": {
     "items": {
      "type": "string"
     },
     "minItems": 1,
     "title": "Evidence Ids",
     "type": "array"
    }
   },
   "required": [
    "rank",
    "failure_type",
    "rationale",
    "evidence_ids"
   ],
   "title": "CauseCandidate",
   "type": "object"
  },
  "InspectionStep": {
   "additionalProperties": false,
   "description": "점검·조치 단계. **LLM 이 쓰되 근거 ID 가 없으면 받지 않는다.**",
   "properties": {
    "order": {
     "minimum": 1,
     "title": "Order",
     "type": "integer"
    },
    "instruction": {
     "title": "Instruction",
     "type": "string"
    },
    "evidence_ids": {
     "items": {
      "type": "string"
     },
     "minItems": 1,
     "title": "Evidence Ids",
     "type": "array"
    }
   },
   "required": [
    "order",
    "instruction",
    "evidence_ids"
   ],
   "title": "InspectionStep",
   "type": "object"
  },
  "ReviewDecision": {
   "additionalProperties": false,
   "description": "정비 기술자의 검토 결과. 이것이 있어야 보고서가 된다(SOP-EA-01 7.2).",
   "properties": {
    "decision": {
     "enum": [
      "approve",
      "revise",
      "escalate",
      "reject"
     ],
     "title": "Decision",
     "type": "string"
    },
    "reviewer_role": {
     "maxLength": 40,
     "minLength": 1,
     "title": "Reviewer Role",
     "type": "string"
    },
    "note": {
     "default": "",
     "maxLength": 400,
     "title": "Note",
     "type": "string"
    }
   },
   "required": [
    "decision",
    "reviewer_role"
   ],
   "title": "ReviewDecision",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "description": "정비 보고서. SOP-EA-01 7.1 의 항목을 그대로 따른다.",
 "properties": {
  "event_id": {
   "title": "Event Id",
   "type": "string"
  },
  "equipment_id": {
   "title": "Equipment Id",
   "type": "string"
  },
  "detected_at": {
   "title": "Detected At",
   "type": "string"
  },
  "prediction": {
   "description": "예측 유형·확률·확신도를 한 줄로",
   "title": "Prediction",
   "type": "string"
  },
  "criteria_summary": {
   "items": {
    "type": "string"
   },
   "title": "Criteria Summary",
   "type": "array"
  },
  "route": {
   "enum": [
    "grounded_draft",
    "escalation",
    "inspect_only"
   ],
   "title": "Route",
   "type": "string"
  },
  "cause_candidates": {
   "items": {
    "$ref": "#/$defs/CauseCandidate"
   },
   "title": "Cause Candidates",
   "type": "array"
  },
  "inspection_steps": {
   "items": {
    "$ref": "#/$defs/InspectionStep"
   },
   "title": "Inspection Steps",
   "type": "array"
  },
  "parts_to_prepare": {
   "items": {
    "type": "string"
   },
   "title": "Parts To Prepare",
   "type": "array"
  },
  "result": {
   "description": "점검·조치 결과. 초안 단계에서는 '점검 후 기입'",
   "title": "Result",
   "type": "string"
  },
  "escalation": {
   "items": {
    "type": "string"
   },
   "title": "Escalation",
   "type": "array"
  },
  "drafted_by": {
   "enum": [
    "llm",
    "fixture_script",
    "code"
   ],
   "title": "Drafted By",
   "type": "string"
  },
  "review": {
   "$ref": "#/$defs/ReviewDecision"
  }
 },
 "required": [
  "event_id",
  "equipment_id",
  "detected_at",
  "prediction",
  "criteria_summary",
  "route",
  "cause_candidates",
  "inspection_steps",
  "parts_to_prepare",
  "result",
  "escalation",
  "drafted_by",
  "review"
 ],
 "title": "MaintenanceReport",
 "type": "object"
}
